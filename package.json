{
  "name": "motion",
  "version": "1.0.0",
  "description": "",
  "main": "run_kokoro_tests.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
  "test": "timeout 900s playwright test",
    "test:unit": "timeout 900s playwright test dev/web_viewer/tests/unit --reporter=line",
    "test:scheduler": "timeout 900s playwright test dev/web_viewer/tests/unit/scheduler --reporter=line",
    "test:unit:serverless": "timeout 900s playwright test --project=component-tests dev/web_viewer/tests/unit --reporter=line",
    "test:unit:web": "timeout 900s playwright test --project=unit-web dev/web_viewer/tests/unit --reporter=line",
  "test:unit:animation": "timeout 900s playwright test --project=unit-web dev/web_viewer/tests/unit/animation --reporter=line",
  "test:unit:animation:vrm-smoke": "timeout 900s playwright test --project=unit-web dev/web_viewer/tests/unit/animation/vrm-integration-smoke-web.spec.js --reporter=line",
  "test:unit:animation:mixer": "timeout 900s playwright test --project=unit-web dev/web_viewer/tests/unit/animation/timeline-mixer-*.spec.js --reporter=line",
  "test:ml:serverless": "timeout 900s playwright test --project=component-tests dev/web_viewer/tests/unit/ai/*.serverless.spec.js --reporter=line",
  "test:ml:ort-smoke": "timeout 900s playwright test --project=unit-web dev/web_viewer/tests/unit/ai/a2g-ort-session-run-web.spec.js --reporter=line",
  "test:ml:ort-all": "timeout 900s playwright test --project=unit-web dev/web_viewer/tests/unit/ai/*.spec.js --reporter=line",
  "test:ml:ort-all:urls": "timeout 900s RUNTIME_ORT=$RUNTIME_ORT WHISPER_URL=$WHISPER_URL VAD_URL=$VAD_URL FACEFORMER_URL=$FACEFORMER_URL SPEECHT5_URL=$SPEECHT5_URL npx playwright test --project=unit-web dev/web_viewer/tests/unit/ai/*.spec.js --reporter=line",
  "test:stubs": "timeout 900s playwright test --project=component-tests dev/web_viewer/tests/unit/*/*stubs*.serverless.spec.js --reporter=line",
    "test:taskmanager": "timeout 900s playwright test tests/taskmanager.test.js",
    "test:taskmanager:headed": "timeout 900s playwright test tests/taskmanager.test.js --headed",
    "test:perf": "timeout 900s playwright test tests/taskmanager.test.js --grep='FLOPS benchmark|Memory bandwidth|Scalability'",
    "serve": "python3 -m http.server 8080",
    "dev": "python3 -m http.server 8080 &",
    "serve:web_viewer": "PORT=8080 python3 dev/web_viewer/serve_with_headers.py",
  "dev:web_viewer": "PORT=8080 python3 dev/web_viewer/serve_with_headers.py",
  "test:e2e:root-smokes": "timeout 900s PW_GREP='VRM bind smoke|Classroom Start|Conversation smoke|Realtime producers smoke' playwright test --project=web_viewer-root-e2e --reporter=line",
  "test:e2e:realtime": "timeout 900s playwright test --project=web_viewer-root-e2e -g 'Realtime producers smoke' --reporter=line"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navichat/motion.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/navichat/motion/issues"
  },
  "homepage": "https://github.com/navichat/motion#readme",
  "dependencies": {
    "@playwright/test": "^1.54.1",
    "playwright": "^1.54.1",
    "kokoro-js": "^1.2.1"
  }
}
